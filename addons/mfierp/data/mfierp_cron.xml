<odoo noupdate="1">
    <record id="cron_dispatch" model="ir.cron">
        <field name="name">MFIERP: Dispatch Approved Commands</field>
        <field name="model_id" ref="model_mfierp_command"/>
        <field name="state">code</field><field name="code">model._cron_dispatch()</field>
        <field name="interval_number">1</field><field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/><field name="active">True</field>
    </record>
    <record id="cron_sync" model="ir.cron">
        <field name="name">MFIERP: Synchronize Enabled Connections</field>
        <field name="model_id" ref="model_mfierp_backend"/>
        <field name="state">code</field><field name="code">model._cron_sync()</field>
        <field name="interval_number">15</field><field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/><field name="active">True</field>
    </record>
</odoo>

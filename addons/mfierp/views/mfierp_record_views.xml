<odoo>
    <record id="mfierp_record_view_list" model="ir.ui.view">
        <field name="name">mfierp.record.list</field><field name="model">mfierp.record</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="name"/><field name="kind" optional="show"/><field name="account_no" optional="show"/>
                <field name="status"/><field name="client_name" optional="show"/><field name="office_name" optional="show"/>
                <field name="product_name" optional="hide"/><field name="currency_code" optional="show"/>
                <field name="gl_code" optional="hide"/><field name="entry_type" optional="hide"/>
                <field name="transaction_id" optional="hide"/><field name="journal_date" optional="hide"/><field name="journal_amount" optional="hide"/>
                <field name="principal" optional="hide"/><field name="outstanding" optional="hide"/><field name="balance" optional="hide"/>
                <field name="backend_id" optional="show"/><field name="synced_at" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="mfierp_record_view_search" model="ir.ui.view">
        <field name="name">mfierp.record.search</field><field name="model">mfierp.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="account_no"/><field name="external_id"/><field name="client_name"/>
                <field name="office_name"/><field name="status"/><field name="backend_id"/>
                <group>
                    <filter name="group_kind" string="Resource" context="{'group_by': 'kind'}"/>
                    <filter name="group_office" string="Office" context="{'group_by': 'office_name'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_currency" string="Currency" context="{'group_by': 'currency_code'}"/>
                    <filter name="group_backend" string="Connection" context="{'group_by': 'backend_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="mfierp_record_view_form" model="ir.ui.view">
        <field name="name">mfierp.record.form</field><field name="model">mfierp.record</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button name="action_refresh" type="object" string="Refresh from Fineract"/>
                    <button name="action_workspace" type="object" string="More Workflows"/>
                    <button name="action_report" type="object" string="Run Report" class="oe_highlight" invisible="kind != 'report'"/>
                    <button name="action_operation" type="object" string="New Operation" class="oe_highlight" groups="mfierp.group_operator" invisible="kind not in ['client', 'group', 'center', 'loan', 'savings']"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status">Fineract snapshot. Refresh to see the latest remote state. Amounts are shown in the account currency; the financial engine validates each submitted operation.</div>
                    <h1><field name="name"/></h1>
                    <group>
                        <group><field name="kind"/><field name="remote_id"/><field name="external_id"/><field name="account_no"/><field name="status"/></group>
                        <group><field name="backend_id"/><field name="company_id" groups="base.group_multi_company"/><field name="office_name"/><field name="client_name"/><field name="product_name"/><field name="synced_at"/></group>
                    </group>
                    <group string="Client Information" invisible="kind != 'client'"><field name="mobile_no"/><field name="activation_date"/></group>
                    <group string="Product Information" invisible="kind not in ['loan_product', 'savings_product']"><field name="interest_rate"/><field name="description"/></group>
                    <group string="Ledger Information" invisible="kind not in ['glaccount', 'journal']">
                        <field name="gl_code"/><field name="entry_type"/><field name="transaction_id"/><field name="journal_date"/><field name="journal_amount"/>
                    </group>
                    <group string="Financial Position" invisible="kind not in ['loan', 'savings']">
                        <field name="financial_details_at"/>
                        <field name="currency_code"/><field name="principal" invisible="kind != 'loan' or not financial_details_at"/>
                        <field name="outstanding" invisible="kind != 'loan' or not financial_details_at"/><field name="balance" invisible="kind != 'savings' or not financial_details_at"/>
                    </group>
                    <notebook>
                        <page string="Schedule, Transactions and Charges" invisible="kind not in ['loan', 'savings']">
                            <field name="line_ids"><list create="false" edit="false" delete="false">
                                <field name="kind"/><field name="remote_id"/><field name="name"/><field name="date"/>
                                <field name="currency_code"/><field name="amount"/><field name="outstanding"/><field name="completed"/>
                            </list></field>
                        </page>
                        <page string="Remote Snapshot" groups="mfierp.group_manager"><field name="raw_data" widget="json"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="mfierp_record_action" model="ir.actions.act_window">
        <field name="name">Portfolio Explorer</field><field name="res_model">mfierp.record</field>
        <field name="view_mode">list,form</field><field name="search_view_id" ref="mfierp_record_view_search"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Connect Fineract and synchronize your portfolio</p><p>An administrator can configure a company connection under Configuration. Use New Operation to submit a reviewed financial request.</p></field>
    </record>
</odoo>

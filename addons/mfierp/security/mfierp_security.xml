<odoo>
    <record id="privilege_mfierp" model="res.groups.privilege">
        <field name="name">MFIERP</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
    </record>
    <record id="group_reader" model="res.groups">
        <field name="name">Portfolio Reader</field>
        <field name="privilege_id" ref="privilege_mfierp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="sequence">10</field>
    </record>
    <record id="group_operator" model="res.groups">
        <field name="name">Operator / Maker</field>
        <field name="privilege_id" ref="privilege_mfierp"/>
        <field name="implied_ids" eval="[(4, ref('group_reader'))]"/>
        <field name="sequence">20</field>
    </record>
    <record id="group_checker" model="res.groups">
        <field name="name">Checker</field>
        <field name="privilege_id" ref="privilege_mfierp"/>
        <field name="implied_ids" eval="[(4, ref('group_reader'))]"/>
        <field name="sequence">30</field>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_mfierp"/>
        <field name="implied_ids" eval="[(4, ref('group_operator')), (4, ref('group_checker'))]"/>
        <field name="sequence">40</field>
    </record>
</odoo>
